# Copy to .env and fill in. NEVER commit .env (it is in .gitignore).
# In GitHub Actions, put the same names under Settings > Secrets and variables > Actions.

# --- Ideas (optional but avoids GitHub rate limits) ---
GITHUB_TOKEN=

# --- Script drafting (optional: without it, template scripts are used) ---
ANTHROPIC_API_KEY=

# --- Voice (optional: without it, reels render silent) ---
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# --- Instagram (Business/Creator account linked to a Facebook Page) ---
IG_USER_ID=
IG_ACCESS_TOKEN=

# --- Threads (only if publish.threads is true in config.json) ---
THREADS_USER_ID=
THREADS_ACCESS_TOKEN=

# --- Public video hosting: Meta must download the file from a public URL ---
# Cloudflare R2 (S3-compatible). Set publish.public_base_url to your bucket's public domain.
R2_ENDPOINT=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
